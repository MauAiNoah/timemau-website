---
interface Props {
  eyebrow: string;
  title: string;
  intro: string;
  note?: string | undefined;
}

const { eyebrow, title, intro, note } = Astro.props;
---

<section class="page-hero">
  <div class="container reading-width">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p class="page-intro">{intro}</p>
    {note && <p class="status-note"><span></span>{note}</p>}
  </div>
</section>
